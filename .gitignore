# This is a highly detailed and complete .gitignore file designed for modern
# Full-Stack JavaScript/TypeScript projects (monorepos or multi-folder setups).
# Covers Node.js, Frontend, Backend, Database, OS, IDEs, and Testing tools.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependency Directories (Node.js & Package Managers)
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/

# Package manager lock files (uncomment if you want to ignore lock files - not recommended for production apps)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# bun.lockb

# Package manager cache and state
.npm/
.eslintcache
.stylelintcache
.prettiercache
.turbo/
.cache/
.parcel-cache/
.eslintcache
.tsbuildinfo

# ------------------------------------------------------------------------------
# 2. Build Outputs & Distribution Directories
# ------------------------------------------------------------------------------
# General build directories
dist/
build/
out/
target/
bin/
obj/

# Framework specific build directories
.next/
.nuxt/
.output/
.docusaurus/
.vuepress/dist
.serverless/
.svelte-kit/
.astro/
.remix/
.expo/

# Compiled files and source maps
*.js.map
*.css.map
*.d.ts.map
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. Environment Variables, Secrets, and Keys (CRITICAL FOR SECURITY)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
.env.example.local
*.env
!*.env.example
!*.env.template

# Credentials, certificates and keys
*.pem
*.key
*.pub
*.cert
*.pfx
*.p12
*.crt
*.der
id_rsa
id_dsa
id_ecdsa
id_ed25519
/certs

# ------------------------------------------------------------------------------
# 4. Logs and Debugging
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun-debug.log*

# Diagnostic/Performance reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.cpuprofile
*.heapprofile
*.memprofile

# ------------------------------------------------------------------------------
# 5. Testing and Coverage Reports
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
.jest/
.vitest/

# Cypress testing artifacts
cypress/screenshots/
cypress/videos/

# Playwright testing artifacts
playwright-report/
test-results/
.playwright/

# ------------------------------------------------------------------------------
# 6. Database and Local Storage (Local Development)
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
.local_db/
dump.rdb
/data
/pgdata
/mongodb_data

# ------------------------------------------------------------------------------
# 7. IDEs, Text Editors, and Developer Tools
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/code-workspace
.history/

# JetBrains (WebStorm, PhpStorm, IntelliJ IDEA, etc.)
.idea/
*.iws
*.iml
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim & Emacs
*~
*.swp
*.swo
.netrwhist
\#*\#
.#*

# Other tools
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory

# ------------------------------------------------------------------------------
# 8. Containerization and Local Deployment (Docker/Terraform)
# ------------------------------------------------------------------------------
.docker/
.terraform/
*.tfstate
*.tfstate.backup

# ------------------------------------------------------------------------------
# 9. Temporary and System Files
# ------------------------------------------------------------------------------
tmp/
temp/
.tmp/
.temp/
*.bak
*.tmp
*.temp
*.old
*.orig
*.swp

# ==============================================================================
# END OF .GITIGNORE
# ==============================================================================

# ==============================================================================
# RECORDING TERNAK - BACKEND .GITIGNORE
# ==============================================================================
# Tailored specifically for Node.js, TypeScript, and Prisma backend services.
# ==============================================================================

# Dependencies
node_modules/
.npm/
.esm/

# TypeScript & Build Outputs
dist/
build/
bin/
obj/
*.tsbuildinfo
*.js.map
*.d.ts.map

# Prisma & Databases (SQLite / Local Databases)
# Ignore local SQLite databases generated by Prisma
*.db
*.db-journal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
dev.db
dev.db-journal

# Environment variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
*.env
!*.env.example
!*.env.template

# Credentials and private keys
*.pem
*.key
*.pub
*.cert
certs/
google-credentials.json

# WhatsApp Web session data
.wwebjs_auth/
.wwebjs_cache/

# Logs and debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
*.cpuprofile
*.heapprofile
*.memprofile

# Testing & Coverage
coverage/
.nyc_output/
.jest/
.vitest/

# IDEs & Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# OS-specific files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
desktop.ini

# Temporary files
tmp/
temp/
.tmp/
.temp/
*.bak
*.tmp
*.old
