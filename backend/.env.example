PORT=5000

GEMINI_API_KEY=your_gemini_api_key_here
SPREADSHEET_ID=your_google_spreadsheet_id_here
SHEET_RECORDING=Recording
SHEET_KAMBING=Kambing
SHEET_PETERNAK=Peternak

WA_ACCESS_TOKEN=your_wa_access_token
WA_PHONE_NUMBER_ID=your_wa_phone_number_id
WA_VERIFY_TOKEN=your_wa_verify_token
WA_APP_SECRET=your_wa_app_secret

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

DB_PASSWORD=your_db_password
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
# Google Client ID milik frontend dashboard-kematian-ternak — Google login sekarang
# diverifikasi di sini untuk kedua app, jadi audience harus menerima keduanya.
DASHBOARD_GOOGLE_CLIENT_ID=dashboard_google_client_id_here

# Integrasi dengan dashboard-kematian-ternak — JWT_SECRET & INTERNAL_API_KEY
# harus SAMA PERSIS dengan yang dipakai backend dashboard-kematian-ternak.
INTERNAL_API_KEY=your_shared_internal_api_key_here

# DEV (local) — jalankan backend dashboard-kematian-ternak di port lain (mis. 5001)
# kalau menjalankan kedua backend bersamaan, karena keduanya default PORT=5000.
DASHBOARD_API_URL=http://localhost:5001
# PROD (Vercel) — set nilai di bawah ini di Vercel dashboard project recording-ternak,
# bukan di file .env:
# DASHBOARD_API_URL=https://api.kematian-ternak.nirmalabesuki.com